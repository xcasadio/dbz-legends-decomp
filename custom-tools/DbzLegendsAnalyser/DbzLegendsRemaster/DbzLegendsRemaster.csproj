<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\PsxSdkMonogame\PsxSdkMonogame\PsxSdkMonogame.csproj" />
    <ProjectReference Include="..\PsxTools\PsxTools.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\..\data\MOVIE\BANDAI.STR">
      <Link>data\MOVIE\BANDAI.STR</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\data\MOVIE\DBZ_OP.STR">
      <Link>data\MOVIE\DBZ_OP.STR</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\data\SUB\TITLE.B">
      <Link>data\SUB\TITLE.B</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\data\SUB\USAGI.B">
      <Link>data\SUB\USAGI.B</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\data\SELECT.EXE">
      <Link>data\SELECT.EXE</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\data\MOVIE.EXE">
      <Link>data\MOVIE.EXE</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\data\TITLE.EXE">
      <Link>data\TITLE.EXE</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\data\VS.EXE">
      <Link>data\VS.EXE</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\data\SLPS_003.55">
      <Link>data\SLPS_003.55</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\data\ENDING.EXE">
      <Link>data\ENDING.EXE</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- The archives the runtime asks the disc for by name. Until these were deployed, every one
         of them made CdSearchFile miss on a perfectly translated host path, which read like a
         filename bug and was a deployment gap: \CHR_DATA\LOAD.B;1 froze the boot before the loops
         were removed, and named itself afterwards. Globs rather than one entry per file, so a new
         archive in one of these directories does not need this list edited again.

         CHR_DATA  the loading picture, the portraits, the shared effect textures
         STG       the eight stage archives, STGxTX.B, reached through ReadFile @ 0x80057DF4
         CH_BIN1   the per-fighter \CH_BIN1\CH_xx.BIN;1, whose name VS.EXE builds at runtime

         DELIBERATELY NOT DEPLOYED: data/SOUND (119 MB) and data/tracks (211 MB, the CD audio) —
         no call site names either today. data/SUB carries sixteen archives but only the two the
         runtime actually asks for are listed above, to keep the output small. -->
    <Content Include="..\..\..\data\CHR_DATA\*.B">
      <Link>data\CHR_DATA\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\data\STG\*.B">
      <Link>data\STG\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- AT1 / AT2, 2.5 MB together, added when FUN_80026d08 was ported: it opens
         \AT1\GKN.B;1 and its siblings through FileIo.ReadFile, and without them the boot threw
         FileNotFoundException at frame 1, which is the DESIGNED behaviour (this port does not
         simulate a CD drive; a missing file fails by name) and is exactly how the gap was found. -->
    <Content Include="..\..\..\data\AT1\*.B">
      <Link>data\AT1\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\data\AT2\*.B">
      <Link>data\AT2\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <Content Include="..\..\..\data\CH_BIN1\*.BIN">
      <Link>data\CH_BIN1\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- The sound archives, added when VS_EXE/SoundDriver.cs closed FUN_8005D25C: the sound task
         is now registered with the scheduler, runs at boot, and CdSearchFiles five names. Without
         them the boot throws "CdSearchFile could not resolve \SOUND\BGM.B;1" at the first frame,
         which is the DESIGNED behaviour (this port does not simulate a CD drive) and is exactly how
         the gap was found.

         LISTED ONE BY ONE, not globbed, and CR.B IS THE EXPENSIVE ONE: data/SOUND is 119 MB and
         115 MB of that is CR.B alone, the voice archive. It is here anyway, because the init really
         does CdSearchFile it and CdSearchFile needs a file to EXIST even when only a few of its
         sectors are ever read. Measured, not assumed: with the other four deployed the boot still
         threw "CdSearchFile could not resolve \SOUND\CR.B;1". PreserveNewest copies it once.
         Deleting this one entry costs the sound task and nothing else, if the output size matters
         more than the sound. data/tracks (211 MB, the CD audio) stays undeployed for the reason it
         always did: no call site names it. -->
    <Content Include="..\..\..\data\SOUND\BGM.B">
      <Link>data\SOUND\BGM.B</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\data\SOUND\ABTL.B">
      <Link>data\SOUND\ABTL.B</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\data\SOUND\ATB.B">
      <Link>data\SOUND\ATB.B</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\data\SOUND\CHSE.B">
      <Link>data\SOUND\CHSE.B</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\data\SOUND\CR.B">
      <Link>data\SOUND\CR.B</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="RestoreDotnetTools" BeforeTargets="CollectPackageReferences">
    <Message Text="Restoring dotnet tools (this might take a while depending on your internet speed and should only happen upon building your project for the first time, or after upgrading MonoGame, or clearing your nuget cache)" Importance="High" />
    <Exec Command="dotnet tool restore" />
  </Target>
</Project>